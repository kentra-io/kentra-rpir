# Two in-flight changes MODIFY the same requirement in the same
# capability: archiving either one is refused with a loud conflict
# message (exit 1), by construction (internal/spec.ParseDeltaYAML over the
# OTHER change's YAML delta) — no silent scenario-loss (contrast OpenSpec
# #1246). --force-conflicts overrides, recorded on the ledger record.
#
# The auth capability pre-exists (a brownfield spec.yaml source + its
# spec.md projection), so its first ledger record carries a real
# preImageSha and the from-empty replay exempts it — the archive's own
# post-write guard self-check therefore stays clean.

env HOME=/no-home

exitcode 1 lifecycle archive 100-change-a
stderr 'refused — a conflicting in-flight change touches the same requirement'
stderr 'Password login'
stderr '200-change-b'

exec lifecycle archive --force-conflicts 100-change-a
stderr 'warning: conflict check overridden'

grep '"conflictsOverridden":true' openspec/ledger.jsonl

# B is no longer conflicting (A already archived) and archives clean,
# folding on top of A's already-updated live spec — seq keeps advancing.
exec lifecycle archive 200-change-b
stdout 'seq 2'
grep '"seq":2' openspec/ledger.jsonl

-- lifecycle.yml --
schemaVersion: 1
consentPolicy: off

-- openspec/specs/auth/spec.yaml --
capability: auth
purpose: Authentication.
requirements:
  - name: Password login
    text: The system SHALL allow login.
    scenarios:
      - name: Successful login
        given:
          - a user
        when:
          - they log in
        then:
          - the system SHALL grant a session

-- openspec/specs/auth/spec.md --
<!-- GENERATED by spec-lifecycle from spec.yaml — read-only projection, do not hand-edit. -->

# auth Specification

## Purpose

Authentication.

## Requirements

### Requirement: Password login
<!-- slug: password-login -->

The system SHALL allow login.

#### Scenario: Successful login
<!-- slug: successful-login -->

- **GIVEN** a user
- **WHEN** they log in
- **THEN** the system SHALL grant a session

