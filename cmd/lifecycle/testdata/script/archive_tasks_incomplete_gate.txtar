# `lifecycle archive` refuses by default when the change's plan has a
# milestone `milestoned-plan-dag resolve` reports not done (the
# step-completion gate, design D6) — exit 1, nothing written — with an
# explicit --force-incomplete-tasks escape hatch that is recorded (never
# silent) on the resulting ledger record.
#
# The plan.yaml here is authored directly in the `milestones:` done-state
# shape the hermetic milestoned-plan-dag stub (main_test.go) echoes back
# from `resolve`.

env HOME=/no-home

exitcode 1 lifecycle archive 001-add-login
stderr 'plan has an outstanding milestone'
stderr 'Session handling'
! exists openspec/changes/archive/001-add-login
! exists openspec/ledger.jsonl

exec lifecycle archive --force-incomplete-tasks 001-add-login
stderr 'warning: tasks-completion gate overridden'
stdout 'archived "001-add-login"'

exists openspec/changes/archive/001-add-login
grep '"tasksIncompleteOverridden":true' openspec/ledger.jsonl

-- lifecycle.yml --
schemaVersion: 1
consentPolicy: off

-- openspec/changes/001-add-login/proposal.md --
---
issue: "kentra-io/kafka-dq#1"
---

# Add password login

## Why
Users need to authenticate.

## What Changes
- **auth:** ADDED - password login.

## Impact
- New capability: auth.

-- openspec/changes/001-add-login/specs/auth/spec.yaml --
capability: auth
deltas:
  - op: ADDED
    requirement:
      name: Password login
      text: The system SHALL allow a registered user to authenticate with a username and password.
      scenarios:
        - name: Successful login
          given:
            - a registered user
          when:
            - they submit correct credentials
          then:
            - the system SHALL grant a session

-- openspec/changes/001-add-login/plan.yaml --
milestones:
  - id: 1
    title: Password login
    done: true
  - id: 2
    title: Session handling
    done: false

-- openspec/changes/001-add-login/approval-state.json --
{
  "schemaVersion": 1,
  "change": "001-add-login",
  "gates": [
    {"stage": "refine", "status": "approved", "designSkipped": true, "approvedAt": "2026-07-07T00:00:00Z", "artifacts": {}},
    {"stage": "plan", "status": "approved", "approvedAt": "2026-07-07T00:00:00Z", "artifacts": {}}
  ]
}
