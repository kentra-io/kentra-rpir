# Multi-change, multi-capability history: three archives across two
# capabilities (auth, billing), the second auth change modifying what the
# first one added. `lifecycle guard`'s from-empty replay must reproduce
# BOTH capabilities' live projections byte-exactly from the archived YAML
# deltas, and the digest chain across all three ledger records must hold.

env HOME=/no-home

exec lifecycle archive 001-add-password-login
exec lifecycle archive 002-add-invoicing
exec lifecycle archive 003-mfa

exec lifecycle guard
stdout 'guard: clean \(3 change\(s\), 3 ledger record\(s\) checked\)'

exec lifecycle guard --format json
stdout '"clean": true'
stdout '"findings": \[\]'

-- lifecycle.yml --
schemaVersion: 1
consentPolicy: off

-- openspec/changes/001-add-password-login/proposal.md --
# Add password login

## Why
The `auth` capability does not yet exist.

-- openspec/changes/001-add-password-login/specs/auth/spec.yaml --
capability: auth
deltas:
  - op: ADDED
    requirement:
      name: Password login
      text: The system SHALL allow a registered user to authenticate with a username and password.
      scenarios:
        - name: Successful login with correct password
          given:
            - a registered user with a known password
          when:
            - the user submits the correct username and password
          then:
            - the system SHALL grant an authenticated session

